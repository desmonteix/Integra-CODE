# Puerto HTTP del servidor Express
PORT=3000

# Limite duro de registros totales (ambos tipos de entrada sumados)
MAX_AFORO=150

# Precio en soles de "Solo entrada". Vacio o 0 => se muestra "Por confirmar" en la UI
PRECIO_SOLO_ENTRADA=

# Precio en soles de "Entrada + Bus". Vacio o 0 => se muestra "Por confirmar" en la UI
PRECIO_ENTRADA_BUS=

# URL POST del webhook de n8n. Vacio => el envio del webhook se omite (no rompe el registro)
N8N_WEBHOOK_URL=

# Timeout en milisegundos por intento de envio al webhook
WEBHOOK_TIMEOUT_MS=3000

# Reintentos adicionales tras el primer intento fallido del webhook
WEBHOOK_MAX_RETRIES=1

# Secreto compartido para acceder a /admin. Vacio => /admin responde 404 (deshabilitada)
ADMIN_KEY=

# --- Turso (base de datos) ---
# Crear cuenta gratis en https://turso.tech, luego:
#   turso db create integra-code
#   turso db show integra-code --url          -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create integra-code       -> TURSO_AUTH_TOKEN
# Sin estas dos variables el servidor NO arranca (fail-fast, sin fallback local).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudinary (imagenes de comprobante) ---
# Crear cuenta gratis en https://cloudinary.com -> Dashboard te muestra las 3.
# Sin estas tres variables el servidor NO arranca (fail-fast, sin fallback local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
