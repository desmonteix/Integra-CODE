<%- include('partials/head') %>
  <%- include('partials/iconos') %>
  <main class="contenedor contenedor--admin">
    <h1>Panel del organizador</h1>
    <p class="subtitulo">Revisa los comprobantes, aprueba las entradas y controla el ingreso.</p>
    <%
      const mensajesAviso = {
        aprobado: 'Entrada aprobada. Se intentará enviar el correo con el QR a n8n.',
        rechazado: 'Registro rechazado. No se emitió ninguna entrada.',
        reenviado: 'Reenvío solicitado a n8n con el mismo QR.',
        no_pendiente: 'Ese registro ya no estaba pendiente. No se cambió nada.',
        no_aprobado: 'Ese registro todavía no está aprobado: no hay QR para reenviar.',
        id_invalido: 'No se pudo identificar el registro. Vuelve a intentar desde la tabla.',
        error_aprobar: 'No se pudo emitir la entrada. El registro sigue pendiente: vuelve a intentar.',
        falta_base_url: 'BASE_URL falta o no es válida. Corrige la configuración antes de aprobar entradas.',
      };
      const mensajeAviso = Object.prototype.hasOwnProperty.call(mensajesAviso, aviso) ? mensajesAviso[aviso] : '';
    %>
    <% if (mensajeAviso) { %>
      <p class="alerta <%= ['id_invalido', 'error_aprobar', 'falta_base_url'].includes(aviso) ? 'alerta-error' : 'alerta-exito' %>" role="status"><%= mensajeAviso %></p>
    <% } %>
    <% if (aviso === 'lote') { %>
      <p class="alerta alerta-exito" role="status">
        Lote procesado: <%= avisoLote.ok %> aprobadas<% if (avisoLote.error !== '0') { %>,
        <%= avisoLote.error %> con error (siguen pendientes)<% } %>.
        Quedan <%= avisoLote.restantes %> pendientes.
      </p>
    <% } %>

    <section>
      <h2>
        <svg class="icono" aria-hidden="true"><use href="#icono-ticket"></use></svg>
        Resumen de aforo
      </h2>
      <p class="resumen-aforo__linea">
        <strong><%= totalRegistrados %></strong> / <%= aforoMaximo %> registrados —
        <strong><%= disponibles %></strong> cupo(s) disponible(s)
      </p>

      <ul class="conteo-organizaciones">
        <% conteoOrganizaciones.forEach(function (item) { %>
          <li class="conteo-organizaciones__item">
            <span class="conteo-organizaciones__icono" aria-hidden="true">
              <svg class="icono"><use href="#icono-edificio"></use></svg>
            </span>
            <span class="conteo-organizaciones__nombre"><%= item.etiqueta %></span>
            <span class="conteo-organizaciones__cantidad"><%= item.cantidad %></span>
          </li>
        <% }); %>
      </ul>
    </section>

    <section class="resumen-entradas">
      <h2>Entradas</h2>
      <ul class="resumen-entradas__lista">
        <li><strong><%= conteoEstados.pendiente %></strong> pendientes de aprobar</li>
        <li><strong><%= conteoEstados.aprobado %></strong> aprobadas</li>
        <li><strong><%= conteoEstados.rechazado %></strong> rechazadas</li>
        <li><strong><%= conteoEstados.ingresados %></strong> ya ingresaron al evento</li>
      </ul>
      <% if (conteoEstados.pendiente > 0) { %>
        <form class="acciones-entrada" method="post" action="/admin/aprobar-pendientes?key=<%= claveEncodeada %>">
          <button type="submit">Aprobar las próximas 10 pendientes</button>
        </form>
        <p class="resumen-entradas__ayuda">Se procesan de a 10 por vez. Vuelve a tocar el botón hasta que no queden pendientes.</p>
      <% } %>
      <h3>Teléfono de la puerta</h3>
      <p class="resumen-entradas__ayuda">Abre este enlace en el teléfono que va a escanear. Cada QR que escanee marcará el ingreso directamente. El permiso vence en 12 horas.</p>
      <p><a href="<%= urlAccesoStaff %>">Autorizar este dispositivo para escanear</a></p>
    </section>

    <section>
      <h2>
        <svg class="icono" aria-hidden="true"><use href="#icono-billetera"></use></svg>
        Precios
      </h2>

      <%# role="status" (no "alert"): es una confirmacion, no una condicion de
          error, y asi los lectores de pantalla la anuncian sin interrumpir. %>
      <% if (guardado) { %>
        <div class="alerta alerta-exito" role="status">
          <strong>Precios guardados.</strong> Ya son los que ve el público en la página de registro.
        </div>
      <% } %>

      <%# Resumen de errores: role="alert" para que se anuncie al volver del
          POST invalido, y tabindex="-1" por si mas adelante se le quiere dar
          foco. Cada input ademas apunta a su propio mensaje via
          aria-describedby. %>
      <% if (detallesPrecios.length > 0) { %>
        <div class="alerta alerta-error" role="alert" tabindex="-1">
          <div>
            <strong>No se guardó ningún precio.</strong> Corrige lo siguiente:
            <ul class="lista-errores">
              <% detallesPrecios.forEach(function (detalle) { %>
                <li><%= detalle %></li>
              <% }); %>
            </ul>
          </div>
        </div>
      <% } %>

      <form class="form-precios" method="post" action="<%= accionPrecios %>" aria-describedby="nota-precios">
        <p class="form-precios__nota" id="nota-precios">
          Escribí un monto o un texto como «Sold Out». El texto deja esa opción fuera del
          registro. Dejá un campo vacío para mostrarlo como «Por confirmar». Cambiar un precio
          <strong>no modifica</strong> lo que ya pagaron los registros existentes.
        </p>

        <%
          // Un solo bloque para los 3 campos: mismo markup, mismas reglas de
          // accesibilidad, un unico lugar donde corregirlas. El `nombre` es la
          // etiqueta visible; `tipo` es la clave interna (y el name del campo
          // es precio_<tipo>, lo que espera validarPrecios).
          var camposPrecio = [
            { tipo: 'solo_entrada', nombre: 'Solo entrada' },
            { tipo: 'entrada_bus', nombre: 'Entrada + Bus' },
            { tipo: 'solo_bus', nombre: 'Solo bus' }
          ];
        %>
        <% camposPrecio.forEach(function (campo) { %>
          <%
            var idInput = 'precio_' + campo.tipo;
            var idAyuda = 'ayuda-' + campo.tipo;
            var idError = 'error-' + campo.tipo;
            var tieneError = Object.prototype.hasOwnProperty.call(erroresPrecios, campo.tipo);
            // aria-describedby encadena la ayuda (lo que ve el publico hoy) y,
            // si corresponde, el mensaje de error de ESTE campo.
            var describedBy = tieneError ? idAyuda + ' ' + idError : idAyuda;
          %>
          <div class="campo campo--precio">
            <label for="<%= idInput %>"><%= campo.nombre %></label>
            <div class="campo--precio__fila">
              <input
                type="text"
                id="<%= idInput %>"
                name="<%= idInput %>"
                value="<%= valoresPrecios[campo.tipo] %>"
                autocomplete="off"
                maxlength="32"
                placeholder="Monto o texto"
                aria-describedby="<%= describedBy %>"
                <% if (tieneError) { %>aria-invalid="true"<% } %>
              />
            </div>
            <p class="campo--precio__ayuda" id="<%= idAyuda %>">
              El público ve: <strong><%= preciosPublicados[campo.tipo] %></strong>
            </p>
            <% if (tieneError) { %>
              <p class="error-campo" id="<%= idError %>"><%= erroresPrecios[campo.tipo] %></p>
            <% } %>
          </div>
        <% }); %>

        <button type="submit">Guardar precios</button>
      </form>
    </section>

    <section>
      <h2>
        <svg class="icono" aria-hidden="true"><use href="#icono-usuario"></use></svg>
        Registros (<%= registros.length %>)
      </h2>
      <div class="tabla-admin__envoltura">
        <table class="tabla-admin">
          <thead>
            <tr>
              <th class="tabla-admin__col-id">ID</th>
              <th>Nombre completo</th>
              <th>Organización</th>
              <th>Tipo de entrada</th>
              <th>Fecha</th>
              <th>Comprobante</th>
              <th>Entrada</th>
            </tr>
          </thead>
          <tbody>
            <% if (registros.length === 0) { %>
              <tr>
                <td colspan="7" class="tabla-admin__vacio">Todavía no hay registros.</td>
              </tr>
            <% } %>
            <% registros.forEach(function (registro) { %>
              <tr>
                <td class="tabla-admin__col-id"><%= registro.id %></td>
                <td><%= registro.nombre_completo %></td>
                <td><%= etiquetaOrganizacion(registro.organizacion) %></td>
                <%# Mapa de 3 valores (ver ETIQUETAS_TIPO_ENTRADA en
                    src/middleware/validarRegistro.js). Antes habia un ternario
                    binario aca, que mostraba cualquier valor desconocido como
                    "Solo entrada" sin que se notara. %>
                <td><%= etiquetaTipoEntrada(registro.tipo_entrada) %></td>
                <td class="tabla-admin__col-fecha"><%= registro.creado_en %></td>
                <td>
                  <% if (registro.comprobante_url) { %>
                    <a href="<%= registro.comprobante_url %>" target="_blank" rel="noopener noreferrer">Ver comprobante</a>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td class="celda-entrada">
                  <% if (registro.estado_aprobacion === 'pendiente') { %>
                    <span class="etiqueta etiqueta--pendiente">Pendiente</span>
                    <form class="acciones-entrada" method="post" action="/admin/aprobar?key=<%= claveEncodeada %>">
                      <input type="hidden" name="id" value="<%= registro.id %>">
                      <button type="submit">Aprobar y enviar QR</button>
                    </form>
                    <form class="acciones-entrada" method="post" action="/admin/rechazar?key=<%= claveEncodeada %>">
                      <input type="hidden" name="id" value="<%= registro.id %>">
                      <button class="boton-rechazar" type="submit">Rechazar</button>
                    </form>
                  <% } else if (registro.estado_aprobacion === 'rechazado') { %>
                    <span class="etiqueta etiqueta--rechazado">Rechazado</span>
                  <% } else if (registro.estado_aprobacion === 'aprobado') { %>
                    <span class="etiqueta etiqueta--aprobado">Aprobada</span>
                    <p class="celda-entrada__envio"><%= Number(registro.correo_qr_enviado) === 1 ? 'Entregado a n8n' : 'Sin confirmar por n8n' %></p>
                    <p class="celda-entrada__ingreso"><%= registro.ingreso_en ? 'Ingresó ' + registro.ingreso_en : 'No ingresó todavía' %></p>
                    <% if (registro.qr_url) { %>
                      <a href="<%= registro.qr_url %>" target="_blank" rel="noopener noreferrer">Ver QR</a>
                    <% } %>
                    <form class="acciones-entrada" method="post" action="/admin/reenviar?key=<%= claveEncodeada %>">
                      <input type="hidden" name="id" value="<%= registro.id %>">
                      <button type="submit">Reenviar correo</button>
                    </form>
                  <% } else { %>
                    <span class="etiqueta">Estado desconocido</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
<%- include('partials/footer') %>
