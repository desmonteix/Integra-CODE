<%- include('partials/head') %>
  <%- include('partials/iconos') %>

  <header class="hero">
    <span class="hero__blob hero__blob--1" aria-hidden="true"></span>
    <span class="hero__blob hero__blob--2" aria-hidden="true"></span>
    <span class="hero__blob hero__blob--3" aria-hidden="true"></span>
    <div class="hero__contenido">
      <h1>Integra CODE x Tu Pata x Prog REA x Kulture Wasi</h1>
      <span class="hero__lugar">
        <svg class="icono" aria-hidden="true"><use href="#icono-ubicacion"></use></svg>
        Malecón Lurín Mz.J2 - Lt. 30, Cieneguilla
      </span>
    </div>
  </header>

  <main class="contenedor">
    <% if (agotado) { %>
      <div id="mensaje-agotado" class="alerta alerta-agotado">
        <strong>Aforo completo</strong> — ya no se aceptan más registros.
      </div>
    <% } else { %>
      <section class="precios">
        <h2>
          <svg class="icono" aria-hidden="true"><use href="#icono-ticket"></use></svg>
          Precios
        </h2>
        <ul class="precios-lista">
          <li class="precios-item">
            <span class="precios-item__icono" aria-hidden="true">
              <svg class="icono"><use href="#icono-ticket"></use></svg>
            </span>
            <span class="precios-item__nombre">Solo entrada</span>
            <span class="precios-item__precio"><%= precios.solo_entrada %></span>
          </li>
          <li class="precios-item">
            <span class="precios-item__icono" aria-hidden="true">
              <svg class="icono"><use href="#icono-bus"></use></svg>
            </span>
            <span class="precios-item__nombre">Entrada + Bus</span>
            <span class="precios-item__precio"><%= precios.entrada_bus %></span>
          </li>
        </ul>
      </section>

      <section class="instrucciones-pago">
        <h2>
          <svg class="icono" aria-hidden="true"><use href="#icono-billetera"></use></svg>
          ¿Cómo pagar?
        </h2>
        <div class="instrucciones-pago__cuerpo">
          <span class="instrucciones-pago__icono" aria-hidden="true">
            <svg class="icono"><use href="#icono-telefono"></use></svg>
          </span>
          <p>
            Yapea al <strong><%= yapeNumero %></strong> (Nombre: <%= yapeTitular %>) y adjunta
            la captura del comprobante en el formulario de abajo.
          </p>
        </div>
      </section>

      <div id="mensaje-exito" class="alerta alerta-exito" hidden></div>
      <div id="mensaje-error-general" class="alerta alerta-error" hidden></div>

      <form id="form-registro" novalidate>
        <div class="campo">
          <label for="nombre_completo">
            <svg class="icono" aria-hidden="true"><use href="#icono-usuario"></use></svg>
            Nombre completo
          </label>
          <input type="text" id="nombre_completo" name="nombre_completo" required />
          <p class="error-campo" data-error-para="nombre_completo"></p>
        </div>

        <div class="campo">
          <label for="dni">
            <svg class="icono" aria-hidden="true"><use href="#icono-id"></use></svg>
            DNI
          </label>
          <input type="text" id="dni" name="dni" inputmode="numeric" autocomplete="off" required />
          <p class="error-campo" data-error-para="dni"></p>
        </div>

        <div class="campo">
          <label for="celular">
            <svg class="icono" aria-hidden="true"><use href="#icono-telefono"></use></svg>
            Celular
          </label>
          <input type="text" id="celular" name="celular" inputmode="numeric" autocomplete="off" required />
          <p class="error-campo" data-error-para="celular"></p>
        </div>

        <div class="campo">
          <label for="correo">
            <svg class="icono" aria-hidden="true"><use href="#icono-correo"></use></svg>
            Correo
          </label>
          <input type="email" id="correo" name="correo" required />
          <p class="error-campo" data-error-para="correo"></p>
        </div>

        <div class="campo">
          <label for="organizacion">
            <svg class="icono" aria-hidden="true"><use href="#icono-edificio"></use></svg>
            Organización
          </label>
          <select id="organizacion" name="organizacion" required>
            <option value="" disabled selected>Selecciona tu organización</option>
            <option value="CODE">CODE</option>
            <option value="Tu Pata">Tu Pata</option>
            <option value="Prog REA">Prog REA</option>
            <option value="Kulture Wasi">Kulture Wasi</option>
            <option value="Externo">Externo</option>
          </select>
          <p class="error-campo" data-error-para="organizacion"></p>
        </div>

        <fieldset class="campo campo--fieldset">
          <legend>
            <svg class="icono" aria-hidden="true"><use href="#icono-ticket"></use></svg>
            Tipo de entrada
          </legend>
          <div class="opciones-entrada">
            <label class="tarjeta-entrada">
              <input type="radio" name="tipo_entrada" value="solo_entrada" required />
              <span class="tarjeta-entrada__icono" aria-hidden="true">
                <svg class="icono"><use href="#icono-ticket"></use></svg>
              </span>
              <span class="tarjeta-entrada__texto">
                <span class="tarjeta-entrada__nombre">Solo entrada</span>
              </span>
              <span class="tarjeta-entrada__precio"><%= precios.solo_entrada %></span>
            </label>
            <label class="tarjeta-entrada">
              <input type="radio" name="tipo_entrada" value="entrada_bus" />
              <span class="tarjeta-entrada__icono" aria-hidden="true">
                <svg class="icono"><use href="#icono-bus"></use></svg>
              </span>
              <span class="tarjeta-entrada__texto">
                <span class="tarjeta-entrada__nombre">Entrada + Bus</span>
              </span>
              <span class="tarjeta-entrada__precio"><%= precios.entrada_bus %></span>
            </label>
          </div>
          <p class="error-campo" data-error-para="tipo_entrada"></p>
        </fieldset>

        <div class="campo">
          <label for="comprobante">
            <svg class="icono" aria-hidden="true"><use href="#icono-imagen"></use></svg>
            Comprobante de pago (imagen)
          </label>
          <input type="file" id="comprobante" name="comprobante" accept="image/*" required />
          <p class="error-campo" data-error-para="comprobante"></p>
        </div>

        <div class="campo">
          <label class="campo-checkbox" for="acepta_terminos">
            <input type="checkbox" id="acepta_terminos" name="acepta_terminos" required />
            Acepto los <button type="button" class="enlace-terminos" id="abrir-terminos">Términos y Condiciones</button>
          </label>
          <p class="error-campo" data-error-para="acepta_terminos"></p>
        </div>

        <button type="submit" id="boton-enviar">Registrarme</button>
      </form>

      <%- include('partials/modal-terminos') %>
    <% } %>
  </main>

  <script src="/js/registro.js"></script>
<%- include('partials/footer') %>
